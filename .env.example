# ---- Speech: Gnani Prisma (STT) + Gnani Timbre (TTS) ----
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_LANGUAGE=en-IN

# ---- LLM (any OpenAI-compatible endpoint) ----
# Currently: Groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# To switch to Gnani Evon, replace the three values above with e.g.:
#   LLM_BASE_URL=http://<your-evon-server>:8000/v1
#   LLM_API_KEY=not-needed
#   LLM_MODEL=gnani-evon-v3.3

# LiveKit — NOT needed for console mode. Only for `python agent.py dev`.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
