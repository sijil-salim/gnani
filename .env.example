# ---- Speech provider (STT + TTS): "deepgram" (current) or "gnani" ----
SPEECH_PROVIDER=deepgram

# Gnani Prisma (STT) + Timbre (TTS) — to switch: add the key and set SPEECH_PROVIDER=gnani
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_VOICE=Pranav
GNANI_TTS_MODEL=timbre-v2.0

# Deepgram (STT + TTS) — currently used
DEEPGRAM_API_KEY=

# ---- LLM (any OpenAI-compatible endpoint) ----
# Currently: Groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# To switch to Gnani Evon, replace the three values above with e.g.:
#   LLM_BASE_URL=http://<your-evon-server>:8000/v1
#   LLM_API_KEY=not-needed
#   LLM_MODEL=gnani-evon-v3.3

# LiveKit — NOT needed for console mode. Only for `python agent.py dev`.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
